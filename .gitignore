# Python caches and compiled bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
venv/
env/
.env

# Raw terminal logs and operating system artifacts
*.log
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# MetaTrader temporary files
*.tst
*.tmp

# Large archives and uncompressed data dumps
*.zip
*.tar.gz
*.7z

# Retain all structured models, source code, summaries, and documentation
!*.md
!*.mq5
!*.ex5
!*.onnx
!*.npz
!*.json
!*.py
!*.csv
